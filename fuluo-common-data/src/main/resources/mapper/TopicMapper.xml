<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shuimumu.fuluogame.mapper.TopicMapper">

    <!--
      话题统计保持纯 UPDATE 是安全的：topic 表 name 为 NOT NULL 且无默认值，话题只能由后台
      AdminService.saveTopic 先创建（行必然存在），此方法仅回写 total_views/total_posts 两个计数，
      不存在「新行缺失」问题；盲目加 INSERT 分支反而会因缺 name 而插入失败。
      与 user_stat 不同（那里必须用真正的 upsert，见 UserStatMapper.xml 的 P0 修复注释）。
    -->
    <update id="upsertBatch">
        UPDATE topic SET
            total_views = CASE id
                <foreach collection="list" item="item">
                    WHEN #{item.id} THEN #{item.totalViews}
                </foreach>
            END,
            total_posts = CASE id
                <foreach collection="list" item="item">
                    WHEN #{item.id} THEN #{item.totalPosts}
                </foreach>
            END
        WHERE id IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>

</mapper>
