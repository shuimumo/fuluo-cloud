# ============================================================
# 福洛游戏 - 环境变量模板
# 使用方法：复制本文件为 .env 后按需填写（.env 已被 gitignore，禁止提交）
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
# ============================================================

# ---------- 基础设施（docker-compose 自动读取本文件做变量替换） ----------
# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3306
# Redis
REDIS_PORT=6379
# RabbitMQ
RABBIT_USER=guest
RABBIT_PWD=guest
RABBIT_PORT=5672
RABBIT_MANAGEMENT_PORT=15672
# Nacos
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_PORT_ALT=9849
# Elasticsearch
ES_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m
# Canal
CANAL_PORT=11111
# Ollama（可选，docker compose --profile ai 启用）
OLLAMA_PORT=11434

# ---------- 应用服务（IDEA / 命令行启动时注入的进程环境变量） ----------
# MySQL（JDBC 端口在各服务 application.yaml 中当前固定为 3306，如需改端口请同步修改）
DB_HOST=127.0.0.1
DB_USER=root
DB_PWD=123456
# Redis
REDIS_HOST=127.0.0.1
# RabbitMQ
RABBIT_HOST=127.0.0.1
# Nacos 注册中心/配置中心地址
NACOS_ADDR=127.0.0.1:8848
# Elasticsearch（fuluo-search）
ES_HOST=127.0.0.1

# ---------- 云厂商密钥（严禁写死进代码/配置，只通过环境变量注入） ----------
# 阿里云 OSS（fuluo-admin 图片上传；缺失时 admin 服务启动失败）
OSS_AK=
OSS_SK=
# 阿里云内容安全 Green（fuluo-post / fuluo-comment 内容审核；缺失时相关服务启动失败）
GREEN_AK=
GREEN_SK=
# DeepSeek（fuluo-ai 帖子总结/润色；缺失时 ai 服务启动失败）
DEEPSEEK_API_KEY=