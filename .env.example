# ============================================================
# 福洛游戏 环境变量模板（复制为 .env 后按需填写真实值）
#
# 用途：消除 nacos-config/fuluo-common.yaml 中的明文密钥。
#       宿主机以 jar 运行的服务与 docker compose 共用这些变量。
# 注意：.env 已被 .gitignore 忽略，严禁提交真实密钥；.env.example 可提交。
# ============================================================

# ---- MySQL ----
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=123456

# ---- RabbitMQ ----
RABBIT_USER=guest
RABBIT_PWD=guest

# ---- 阿里云 OSS（图片上传；开启时需一并提供 AK/SK 与桶名）----
ALIYUN_OSS_ENABLED=false
ALIYUN_OSS_BUCKET_NAME=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# ---- 阿里云 Green（文本/图片内容审核；开启时需一并提供 AK/SK）----
ALIYUN_GREEN_ENABLED=false
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=

# ---- AI（DeepSeek，fuluo-ai 使用）----
DEEPSEEK_API_KEY=

# ---- 内容审核总开关（默认 true；压测/联调可置 false 直接放行）----
FULUO_MODERATION_ENABLED=true
